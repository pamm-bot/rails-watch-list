<div class="col-md-4 d-flex" id="<%= dom_id(bookmark) %>">
  <div class="card shadow-sm mb-4 h-100 w-100">
    <div class="position-relative">
      <% if bookmark.movie.poster_url.present? %>
        <img src="<%= bookmark.movie.poster_url %>" class="card-img-top movie-poster">
      <% else %>
        <div class="movie-poster d-flex align-items-center justify-content-center bg-light text-muted small text-center px-2">
          No poster available
        </div>
      <% end %>
      <%= link_to "",
          bookmark_path(bookmark),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "delete-x",
          aria: { label: "Delete" } %>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0"><%= bookmark.movie.title %></h5>
        <% if bookmark.movie.rating.present? %>
          <span class="movie-rating"><i class="fa-star"></i> <%= bookmark.movie.rating %>/10</span>
        <% end %>
      </div>
      <% if bookmark.comment.present? %>
        <p><%= bookmark.comment %></p>
      <% end %>

      <%= form_with model: bookmark, url: bookmark_path(bookmark), method: :patch,
            html: { class: "text-center mb-2", data: { controller: "auto-submit" } } do |f| %>
        <label class="watched-toggle">
          <%= f.check_box :watched, data: { action: "change->auto-submit#submit" } %>
          <span class="watched-toggle-slider"></span>
          <span class="watched-toggle-label">Watched</span>
        </label>
      <% end %>

      <% if bookmark.watched? %>
        <hr>
        <% if bookmark.reviews.any? %>
          <ul class="list-group mb-2">
            <% bookmark.reviews.each do |review| %>
              <li class="list-group-item">
                <span class="star-display">
                  <% (1..5).each do |n| %>
                    <i class="fa-star <%= "filled" if n <= review.rating %>"></i>
                  <% end %>
                </span>
                — <%= review.content %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= simple_form_for [bookmark, Review.new] do |f| %>
            <%= f.input :content, label: "Review" %>
            <div class="form-group mb-2">
              <label>Rating</label>
              <div class="star-rating">
                <% (5).downto(1) do |n| %>
                  <%= f.radio_button :rating, n, id: "bookmark_#{bookmark.id}_rating_#{n}" %>
                  <%= f.label :rating, for: "bookmark_#{bookmark.id}_rating_#{n}" do %>
                    <span class="visually-hidden"><%= n %> stars</span>
                  <% end %>
                <% end %>
              </div>
            </div>
            <%= f.submit "Submit", class: "btn btn-ocean btn-sm d-block mx-auto" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
