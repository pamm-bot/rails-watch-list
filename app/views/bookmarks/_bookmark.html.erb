<div class="col-md-4 d-flex" id="<%= dom_id(bookmark) %>">
  <div class="card shadow-sm mb-4 h-100 w-100">
    <div class="position-relative">
      <img src="<%= bookmark.movie.poster_url %>" class="card-img-top movie-poster">
      <%= link_to "",
          bookmark_path(bookmark),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "delete-x",
          aria: { label: "Delete" } %>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0"><%= bookmark.movie.title %></h5>
        <% if bookmark.movie.rating.present? %>
          <span class="movie-rating"><i class="fa-star"></i> <%= bookmark.movie.rating %>/10</span>
        <% end %>
      </div>
      <% if bookmark.comment.present? %>
        <p><%= bookmark.comment %></p>
      <% end %>

      <%= form_with model: bookmark, url: bookmark_path(bookmark), method: :patch,
            html: { class: "text-center mb-2", data: { controller: "auto-submit" } } do |f| %>
        <label class="watched-toggle">
          <%= f.check_box :watched, data: { action: "change->auto-submit#submit" } %>
          <span class="watched-toggle-slider"></span>
          <span class="watched-toggle-label">Watched</span>
        </label>
      <% end %>

      <% if bookmark.watched? %>
        <hr>
        <% review = bookmark.reviews.first || bookmark.reviews.build %>
        <%= simple_form_for [bookmark, review] do |f| %>
          <%= f.input :content, label: "Review" %>
          <div class="form-group mb-2">
            <label>Rating</label>
            <div class="star-rating">
              <% (5).downto(1) do |n| %>
                <%= f.radio_button :rating, n, id: "bookmark_#{bookmark.id}_rating_#{n}" %>
                <%= f.label :rating, for: "bookmark_#{bookmark.id}_rating_#{n}" do %>
                  <span class="visually-hidden"><%= n %> stars</span>
                <% end %>
              <% end %>
            </div>
          </div>
          <%= f.submit review.persisted? ? "Update" : "Submit", class: "btn btn-ocean btn-sm d-block mx-auto" %>
        <% end %>

        <% if review.persisted? %>
          <%= button_to "Delete Review", [ bookmark, review ], method: :delete,
              class: "btn btn-link btn-sm text-muted p-0 d-block mx-auto mt-1" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
