<div class="col-md-4 d-flex">
  <div class="card shadow-sm mb-4 h-100 w-100">
    <div class="position-relative">
      <img src="<%= bookmark.movie.poster_url %>" class="card-img-top movie-poster">
      <%= link_to "",
          bookmark_path(bookmark),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "delete-x",
          aria: { label: "Delete" } %>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0"><%= bookmark.movie.title %></h5>
        <% if bookmark.movie.rating.present? %>
          <span class="movie-rating"><i class="fa-star"></i> <%= bookmark.movie.rating %>/10</span>
        <% end %>
      </div>
      <% if bookmark.comment.present? %>
        <p><%= bookmark.comment %></p>
      <% end %>

      <% if bookmark.watched? %>
        <%= button_to "Move back to To Watch",
            bookmark_path(bookmark),
            method: :patch, params: { bookmark: { watched: false } },
            class: "btn btn-link btn-sm text-muted p-0" %>
      <% else %>
        <%= button_to "Mark as Watched",
            bookmark_path(bookmark),
            method: :patch, params: { bookmark: { watched: true } },
            class: "btn btn-outline-ocean btn-sm" %>
      <% end %>

      <% if bookmark.watched? %>
        <hr>
        <% if bookmark.reviews.any? %>
          <ul class="list-group mb-2">
            <% bookmark.reviews.each do |review| %>
              <li class="list-group-item">
                <span class="star-display">
                  <% (1..5).each do |n| %>
                    <i class="fa-star <%= "filled" if n <= review.rating %>"></i>
                  <% end %>
                </span>
                — <%= review.content %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= simple_form_for [bookmark, Review.new] do |f| %>
            <%= f.input :content, label: "Review" %>
            <div class="form-group mb-2">
              <label>Rating</label>
              <div class="star-rating">
                <% (5).downto(1) do |n| %>
                  <%= f.radio_button :rating, n, id: "bookmark_#{bookmark.id}_rating_#{n}" %>
                  <%= f.label :rating, for: "bookmark_#{bookmark.id}_rating_#{n}" do %>
                    <span class="visually-hidden"><%= n %> stars</span>
                  <% end %>
                <% end %>
              </div>
            </div>
            <%= f.submit "Submit Review", class: "btn btn-ocean btn-sm" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
