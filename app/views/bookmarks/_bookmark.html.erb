<div class="col-md-4 d-flex" id="<%= dom_id(bookmark) %>">
  <div class="card shadow-sm mb-4 h-100 w-100">
    <div class="position-relative">
      <img src="<%= bookmark.movie.poster_url %>" class="card-img-top movie-poster">
      <% if bookmark.movie.category.present? %>
        <span class="genre-badge" style="background-color: <%= genre_badge_color(bookmark.movie.category.name) %>;">
          <%= bookmark.movie.category.name %>
        </span>
      <% end %>
      <%= link_to "",
          bookmark_path(bookmark),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "delete-x",
          aria: { label: "Delete" } %>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0"><%= bookmark.movie.title %></h5>
        <% if bookmark.movie.rating.present? %>
          <span class="movie-rating"><i class="fa-star"></i> <%= bookmark.movie.rating %>/10</span>
        <% end %>
      </div>
      <% if bookmark.comment.present? %>
        <p><%= bookmark.comment %></p>
      <% end %>

      <%= form_with model: bookmark, url: bookmark_path(bookmark), method: :patch,
            html: { class: "text-center mb-2", data: { controller: "auto-submit" } } do |f| %>
        <label class="watched-toggle">
          <%= f.check_box :watched, data: { action: "change->auto-submit#submit" } %>
          <span class="watched-toggle-slider"></span>
          <span class="watched-toggle-label">Watched</span>
        </label>
      <% end %>

      <% if bookmark.watched? %>
        <hr>
        <% review = bookmark.reviews.first %>
        <% if review %>
          <div data-controller="toggle">
            <div data-toggle-target="content">
              <% if review.rating.present? %>
                <div class="star-display mb-1">
                  <% 5.times do |i| %><i class="<%= "filled" if i < review.rating %>"></i><% end %>
                </div>
              <% end %>
              <% if review.content.present? %>
                <p class="mb-2"><%= review.content %></p>
              <% end %>
              <div class="d-flex justify-content-center align-items-center gap-2">
                <button type="button" class="btn btn-ocean btn-sm" data-action="click->toggle#toggle">Update</button>
                <%= button_to "Delete", [ bookmark, review ], method: :delete, class: "list-pill-cancel-btn" %>
              </div>
            </div>
            <div class="d-none" data-toggle-target="content">
              <%= render "bookmarks/review_form", bookmark: bookmark, review: review, submit_label: "Save", with_back: true %>
            </div>
          </div>
        <% else %>
          <%= render "bookmarks/review_form", bookmark: bookmark, review: bookmark.reviews.build, submit_label: "Submit" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
