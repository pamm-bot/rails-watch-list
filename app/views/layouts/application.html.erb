<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="My Watch List">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand navbar-dark navbar-ocean py-4">
      <div class="container d-flex justify-content-between align-items-center">
        <%= link_to t("app_name"), root_path, class: "navbar-brand mb-0 h3 text-light" %>
        <div class="d-flex align-items-center gap-3">
          <% if authenticated? && !(controller_name == "lists" && action_name == "index") %>
            <%= link_to t("nav.home"), root_path, class: "nav-link text-light" %>
          <% end %>
          <% if authenticated? %>
            <%= button_to t("nav.log_out"), session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
          <% end %>
          <%# Kept last so the flags stay pinned to the right edge and don't
              shift when the surrounding labels change width between languages. %>
          <div class="locale-switch" role="group" aria-label="<%= t("nav.language") %>">
            <% available_locales.each do |loc| %>
              <%= link_to locale_flag(loc), locale_path(loc),
                    class: "locale-flag#{' is-active' if I18n.locale == loc}",
                    title: t("locales.#{loc}"),
                    aria: { label: t("locales.#{loc}"), current: (I18n.locale == loc ? "true" : nil) } %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <div class="container mt-3">
      <%# Only surface problems — success messages are left to the UI itself. %>
      <% flash.each do |type, message| %>
        <% next if type.to_s == "notice" %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
