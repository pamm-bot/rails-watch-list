<div class="list-pill" data-controller="toggle list-customize" style="--accent: <%= list_accent_color(list, index) %>;">
  <div class="list-pill-row">
    <span class="list-pill-avatar" data-list-customize-target="avatar"><%= list.emoji %></span>
    <%= link_to list.name, list_path(list), class: "list-row-name" %>
    <div class="list-pill-actions">
      <button type="button" class="list-pill-edit-btn" data-action="click->toggle#toggle" aria-label="Customize list">
        <i class="fa-solid fa-pen"></i>
      </button>
      <%= link_to "",
          list_path(list),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "list-row-delete",
          aria: { label: "Delete" } %>
    </div>
  </div>

  <div class="list-pill-edit d-none" data-toggle-target="content">
    <%= simple_form_for list do |f| %>
      <label class="d-block small text-muted mb-1">Avatar</label>
      <div class="emoji-swatches mb-3">
        <label class="emoji-swatch">
          <%= f.radio_button :emoji, "", id: "list_#{list.id}_emoji_none", checked: list.emoji.blank?, data: { action: "change->list-customize#previewEmoji" } %>
          <span>—</span>
        </label>
        <% %w[🎬 🍿 🎥 👻 🚀 🌟 🦄 😎 🍕 🐶 🐱 🦊 🐼].each_with_index do |emoji, emoji_index| %>
          <label class="emoji-swatch">
            <%= f.radio_button :emoji, emoji, id: "list_#{list.id}_emoji_#{emoji_index}", checked: list.emoji == emoji, data: { action: "change->list-customize#previewEmoji" } %>
            <span><%= emoji %></span>
          </label>
        <% end %>
      </div>

      <label class="d-block small text-muted mb-1">Color</label>
      <div class="color-swatches mb-3">
        <% List::ACCENT_COLORS.each_with_index do |color, color_index| %>
          <label class="color-swatch" style="--swatch: <%= color %>;">
            <%= f.radio_button :color, color, id: "list_#{list.id}_color_#{color_index}", checked: list.color == color, data: { action: "change->list-customize#previewColor" } %>
          </label>
        <% end %>
      </div>

      <div class="d-flex justify-content-end align-items-center gap-2">
        <%= f.submit "Save", class: "btn btn-sm btn-ocean" %>
        <button type="button" class="list-pill-back-btn" data-action="click->toggle#toggle" aria-label="Back">
          <i class="fa-solid fa-arrow-rotate-left"></i>
        </button>
      </div>
    <% end %>
  </div>
</div>
