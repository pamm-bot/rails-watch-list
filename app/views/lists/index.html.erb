<div class="container mt-4">
  <div class="card p-3 shadow-sm mb-4">
    <h3>Create a New List</h3>
    <%= simple_form_for @list do |f| %>
      <%= f.input :name, input_html: { class: "form-control-narrow" } %>
      <%= f.input :kids_mode, as: :boolean, label: '<i class="fa-solid fa-shield-halved"></i> Under 12'.html_safe %>
      <%= f.submit "Create List", class: "btn btn-ocean" %>
    <% end %>
  </div>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-md-4">
        <div class="card shadow-sm mb-4 position-relative">
          <%= link_to "",
              list_path(list),
              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
              class: "delete-x",
              aria: { label: "Delete" } %>
          <div class="card-body">
            <h3><%= link_to list.name, list_path(list), class: "list-name" %></h3>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>