<div class="container mt-4">
  <div class="text-center mb-4">
    <h1 class="fw-bold gradient-text"><i class="fa-solid fa-clapperboard"></i> Your Watch Lists</h1>
    <p class="text-muted">Search. Watch. Review.</p>
  </div>

  <div class="card p-3 shadow-sm mb-4 mx-auto" style="max-width: 480px;">
    <h5>Create a New List</h5>
    <%= simple_form_for @list do |f| %>
      <%= f.input :name, input_html: { class: "form-control-narrow" } %>
      <%= f.input :kids_mode, as: :boolean, label: '<i class="fa-solid fa-shield-halved"></i> Under 12'.html_safe %>
      <%= f.submit "Create List", class: "btn btn-ocean" %>
    <% end %>
  </div>

  <% if @lists.any? %>
    <div class="row">
      <% @lists.each_with_index do |list, index| %>
        <div class="col-md-4">
          <div class="card shadow-sm mb-4 position-relative list-card" style="border-top-color: <%= list_accent_color(index) %>;">
            <%= link_to "",
                list_path(list),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "delete-x",
                aria: { label: "Delete" } %>
            <div class="card-body">
              <h3><%= link_to list.name, list_path(list), class: "list-name" %></h3>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state text-center py-5">
      <i class="fa-solid fa-film fa-2x mb-2"></i>
      <p class="mb-0">No lists yet — create your first one above!</p>
    </div>
  <% end %>
</div>
