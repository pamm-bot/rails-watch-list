<div class="container mt-4 lists-home">
  <div class="text-center mb-4">
    <h1 class="fw-bold gradient-text"><i class="fa-solid fa-play"></i> <%= t("lists.index.title") %></h1>
    <p class="text-muted"><%= t("lists.index.tagline") %></p>
  </div>

  <div class="card p-3 shadow-sm mb-4 mx-auto" style="max-width: 480px;">
    <h5><%= t("lists.index.create_heading") %></h5>
    <%= simple_form_for @list do |f| %>
      <%= f.input :name, label: t("lists.form.name") %>
      <%= f.input :kids_mode, as: :boolean, label: ('<i class="fa-solid fa-shield-halved"></i> ' + t("lists.form.kids_mode")).html_safe %>
      <%= f.submit t("lists.index.create_button"), class: "btn btn-ocean" %>
    <% end %>
  </div>

  <% if @lists.any? %>
    <div class="list-menu mt-4">
      <% @lists.each_with_index do |list, index| %>
        <%= render "list_row", list: list, index: index %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state text-center py-5">
      <i class="fa-solid fa-film fa-2x mb-3 d-block"></i>
      <p class="mb-0"><%= t("intro.lead") %></p>
    </div>
  <% end %>
</div>
