<div class="container mt-4" data-controller="toggle">
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0"><%= @list.name %></h1>
    <button type="button" class="btn btn-link p-0 link-ocean" data-action="click->toggle#toggle" aria-label="Rename list">
      <i class="fa-solid fa-pen"></i>
    </button>
  </div>

  <div class="card p-3 shadow-sm mb-3 mt-2 d-none" style="max-width: 400px;" data-toggle-target="content">
    <%= simple_form_for @list do |f| %>
      <%= f.input :name, input_html: { class: "form-control-narrow" } %>
      <%= f.input :kids_mode, as: :boolean, label: '<i class="fa-solid fa-shield-halved"></i> Under 12'.html_safe %>
      <%= f.submit "Save", class: "btn btn-outline-ocean btn-sm d-block mx-auto" %>
    <% end %>
  </div>

  <%= link_to "Search Movies", movies_path(list_id: @list.id), class: "btn btn-ocean mt-3" %>

  <hr>

  <h3>To Watch</h3>
  <div class="row mt-3 movie-grid" id="to_watch_movies">
    <p class="movie-grid-empty">Nothing here yet.</p>
    <%= render @to_watch %>
  </div>

  <hr>

  <h3>Watched</h3>
  <div class="row mt-3 movie-grid" id="watched_movies">
    <p class="movie-grid-empty">No movies marked as watched yet.</p>
    <%= render @watched %>
  </div>
</div>
