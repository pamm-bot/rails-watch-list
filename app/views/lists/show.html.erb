<div class="container mt-4">
  <h1><%= @list.name %></h1>

  <%= link_to "Search & Add a Movie", movies_path(list_id: @list.id), class: "btn btn-primary mt-3" %>

  <%= form_with url: list_path(@list), method: :get, class: "mt-3",
        html: { data: { controller: "auto-submit" } } do %>
    <label for="category_id" class="form-label">Filter by category</label>
    <%= select_tag :category_id,
          options_for_select(@categories.map { |c| [c.name, c.id] }, @selected_category_id),
          include_blank: "All categories", class: "form-select w-auto",
          data: { action: "change->auto-submit#submit" } %>
  <% end %>

  <hr>

  <h3>To Watch</h3>
  <div class="row mt-3">
    <% if @to_watch.empty? %>
      <p>Nothing here yet.</p>
    <% else %>
      <%= render @to_watch %>
    <% end %>
  </div>

  <hr>

  <h3>Watched</h3>
  <div class="row mt-3">
    <% if @watched.empty? %>
      <p>No movies marked as watched yet.</p>
    <% else %>
      <%= render @watched %>
    <% end %>
  </div>
</div>
