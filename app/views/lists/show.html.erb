<div class="container mt-4">
  <h1><%= @list.name %></h1>

  <div class="card p-3 shadow-sm mb-3" style="max-width: 400px;">
    <%= simple_form_for @list do |f| %>
      <%= f.input :name, input_html: { class: "form-control-narrow" } %>
      <%= f.input :kids_mode, as: :boolean, label: '<i class="fa-solid fa-shield-halved"></i> Under 12'.html_safe %>
      <%= f.submit "Save Changes", class: "btn btn-outline-ocean btn-sm" %>
    <% end %>
  </div>

  <%= link_to "Search Movies", movies_path(list_id: @list.id), class: "btn btn-ocean mt-3" %>

  <hr>

  <h3>To Watch</h3>
  <% if @to_watch.empty? %>
    <p>Nothing here yet.</p>
  <% end %>
  <div class="row mt-3" id="to_watch_movies">
    <%= render @to_watch %>
  </div>

  <hr>

  <h3>Watched</h3>
  <% if @watched.empty? %>
    <p>No movies marked as watched yet.</p>
  <% end %>
  <div class="row mt-3" id="watched_movies">
    <%= render @watched %>
  </div>
</div>
