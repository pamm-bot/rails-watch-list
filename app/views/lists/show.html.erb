<div class="container mt-4">
  <h1><%= @list.name %></h1>

  <%= link_to "Search & Add a Movie", movies_path(list_id: @list.id), class: "btn btn-primary mt-3" %>

  <hr>

  <h3>To Watch</h3>
  <div class="row mt-3">
    <% if @to_watch.empty? %>
      <p class="text-muted">Nothing here yet.</p>
    <% else %>
      <%= render @to_watch %>
    <% end %>
  </div>

  <hr>

  <h3>Watched</h3>
  <div class="row mt-3">
    <% if @watched.empty? %>
      <p class="text-muted">No movies marked as watched yet.</p>
    <% else %>
      <%= render @watched %>
    <% end %>
  </div>
</div>
