<div class="container mt-4">
  <h1><%= @list.name %></h1>

  <div class="row mt-4">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4">
        <div class="card shadow-sm mb-4">
          <img src="<%= bookmark.movie.poster_url %>" class="card-img-top">
          <div class="card-body">
            <h5><%= bookmark.movie.title %></h5>
            <p><%= bookmark.comment %></p>

            <%= simple_form_for bookmark.movie, url: movie_path(bookmark.movie), method: :patch do |f| %>
              <%= f.input :category_id, collection: @categories, include_blank: "No category", label: "Category" %>
              <%= f.submit "Save", class: "btn btn-outline-secondary btn-sm" %>
            <% end %>

            <%= link_to "Delete",
                bookmark_path(bookmark),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "btn btn-danger btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <hr>

  <h3>Add a Movie</h3>
  <%= simple_form_for [@list, @bookmark] do |f| %>
    <%= f.association :movie %>
    <%= f.input :comment %>
    <%= f.submit "Add", class: "btn btn-primary" %>
  <% end %>

  <hr>

  <h3>Reviews</h3>
  <% if @list.reviews.any? %>
    <ul class="list-group mb-3">
      <% @list.reviews.each do |review| %>
        <li class="list-group-item">
          <strong><%= review.rating %>/5</strong> — <%= review.content %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">No reviews yet.</p>
  <% end %>

  <%= simple_form_for [@list, @review] do |f| %>
    <%= f.input :content %>
    <%= f.input :rating %>
    <%= f.submit "Submit Review", class: "btn btn-secondary" %>
  <% end %>
</div>