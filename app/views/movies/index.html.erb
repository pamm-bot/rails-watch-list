<div class="container mt-4">
  <h1>Browse Movies</h1>

  <div class="alert alert-info d-flex justify-content-between align-items-center">
    <span>Adding movies to: <strong><%= @list.name %></strong></span>
    <%= link_to "Back to list", list_path(@list), class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <%= form_with url: movies_path, method: :get, class: "d-flex gap-2 mb-4",
        data: { controller: "search", turbo_frame: "movie_results" } do |f| %>
    <%= f.hidden_field :list_id, value: @list.id %>
    <%= f.text_field :query, value: @query, placeholder: "Search for a movie...", class: "form-control",
          data: { action: "input->search#submit" } %>
    <%= f.submit "Search", class: "btn btn-primary" %>
  <% end %>

  <%= turbo_frame_tag "movie_results" do %>
    <% if @query.present? && @results.empty? %>
      <p>No results for "<%= @query %>".</p>
    <% end %>

    <div class="row">
      <% @results.each do |result| %>
        <div class="col-md-3">
          <div class="card shadow-sm mb-4">
            <% if result["poster_path"].present? %>
              <img src="<%= TmdbClient.poster_url(result["poster_path"]) %>" class="card-img-top movie-poster">
            <% end %>
            <div class="card-body">
              <h5><%= result["title"] %></h5>
              <p class="small text-truncate"><%= result["overview"] %></p>

              <% if @titles_in_list.include?(result["title"]) %>
                <span class="badge bg-success">
                  <i class="fa-solid fa-check"></i> Already in list
                </span>
              <% else %>
                <%= form_with url: movies_path, method: :post, data: { turbo_frame: "_top" } do |f| %>
                  <%= f.hidden_field :title, value: result["title"] %>
                  <%= f.hidden_field :overview, value: result["overview"] %>
                  <%= f.hidden_field :poster_path, value: result["poster_path"] %>
                  <%= f.hidden_field :vote_average, value: result["vote_average"] %>
                  <%= f.hidden_field :genre_id, value: result["genre_ids"]&.first %>
                  <%= f.hidden_field :list_id, value: @list.id %>

                  <div class="form-check mb-2">
                    <%= f.check_box :watched, class: "form-check-input" %>
                    <%= f.label :watched, "Already watched?", class: "form-check-label" %>
                  </div>

                  <%= f.submit "Add to #{@list.name}", class: "btn btn-success btn-sm" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
