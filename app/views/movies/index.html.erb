<div class="container mt-4">
  <div class="mb-4">
    <%= link_to list_path(@list), class: "link-ocean d-inline-flex align-items-center gap-2 fs-4 fw-semibold" do %>
      <i class="fa-solid fa-arrow-left"></i> <%= @list.name %>
    <% end %>
  </div>

  <%= form_with url: movies_path, method: :get, class: "d-flex align-items-center gap-2 flex-wrap mb-4",
        data: { controller: "search auto-submit", turbo_frame: "movie_results" } do |f| %>
    <%= f.hidden_field :list_id, value: @list.id %>
    <%= f.text_field :query, value: @query, placeholder: t("movies.search_placeholder"), class: "form-control form-control-narrow",
          data: { action: "input->search#submit" } %>

    <span class="small text-muted ms-auto"><%= t("movies.filter_by") %></span>
    <%= f.select :category_id, @categories.map { |c| [genre_label(c.name), c.id] }, { include_blank: t("movies.category"), selected: @selected_category_id },
          { class: "form-select w-auto", data: { controller: "select-placeholder", action: "change->auto-submit#submit change->select-placeholder#update" } } %>
    <%= f.select :min_rating, [["7+", 7], ["8+", 8], ["9+", 9]], { include_blank: t("movies.rating"), selected: @min_rating },
          { class: "form-select w-auto", data: { controller: "select-placeholder", action: "change->auto-submit#submit change->select-placeholder#update" } } %>
  <% end %>

  <%= turbo_frame_tag "movie_results" do %>
    <% if @results.empty? %>
      <p><%= @query.present? ? t("movies.no_results_for", query: @query) : t("movies.no_results") %></p>
    <% end %>

    <div class="row">
      <% @results.each do |result| %>
        <div class="col-md-3 d-flex">
          <div class="card shadow-sm mb-4 h-100 w-100">
            <div class="position-relative">
              <img src="<%= TmdbClient.poster_url(result["poster_path"]) %>" class="card-img-top movie-poster">
              <% if (genre_name = TmdbClient.genre_name(result["genre_ids"]&.first)) %>
                <span class="genre-badge" style="background-color: <%= genre_badge_color(genre_name) %>;">
                  <%= genre_label(genre_name) %>
                </span>
              <% end %>
            </div>
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start">
                <h5 class="mb-0"><%= result["title"] %></h5>
                <% if result["vote_average"].present? && result["vote_average"].positive? %>
                  <span class="movie-rating"><i class="fa-star"></i> <%= result["vote_average"].round %>/10</span>
                <% end %>
              </div>
              <% if result["overview"].present? %>
                <div data-controller="expandable"
                     data-expandable-more-label-value="<%= t("movies.read_more") %>"
                     data-expandable-less-label-value="<%= t("movies.read_less") %>"
                     data-action="expandable:expanded@window->expandable#collapseOthers">
                  <p class="movie-overview" data-expandable-target="text"><%= result["overview"] %></p>
                  <button type="button" class="overview-toggle" data-expandable-target="button"
                          data-action="expandable#toggle"><%= t("movies.read_more") %></button>
                </div>
              <% end %>

              <div class="mt-auto">
                <% if @titles_in_list.include?(result["title"]) %>
                  <span class="badge bg-success">
                    <i class="fa-solid fa-check"></i> <%= t("movies.already_in_list") %>
                  </span>
                <% else %>
                  <%= form_with url: movies_path, method: :post, class: "text-center", data: { turbo_frame: "_top" } do |f| %>
                    <%= f.hidden_field :title, value: result["title"] %>
                    <%= f.hidden_field :overview, value: result["overview"] %>
                    <%= f.hidden_field :poster_path, value: result["poster_path"] %>
                    <%= f.hidden_field :vote_average, value: result["vote_average"] %>
                    <%= f.hidden_field :genre_id, value: result["genre_ids"]&.first %>
                    <%= f.hidden_field :list_id, value: @list.id %>
                    <%= f.hidden_field :query, value: @query %>
                    <%= f.hidden_field :category_id, value: @selected_category_id %>
                    <%= f.hidden_field :min_rating, value: @min_rating %>

                    <%= f.submit t("movies.add"), class: "btn btn-ocean btn-sm" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
