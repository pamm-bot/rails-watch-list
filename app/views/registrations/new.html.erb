<div class="container mt-4" style="max-width: 400px;">
  <h1><%= t("registrations.new.title") %></h1>

  <div class="card p-3 shadow-sm mb-4">
    <%= simple_form_for @user, url: registration_path do |f| %>
      <%= f.input :email_address, label: t("auth.email"), input_html: { autofocus: true, autocomplete: "username" } %>
      <%= f.input :password, label: t("auth.password"), input_html: { autocomplete: "new-password", maxlength: 72 } %>
      <%= f.input :password_confirmation, label: t("auth.password_confirmation"), input_html: { autocomplete: "new-password", maxlength: 72 } %>
      <%= f.submit t("registrations.new.submit"), class: "btn btn-ocean mt-2" %>
    <% end %>
  </div>

  <p><%= t("registrations.new.have_account") %> <%= link_to t("registrations.new.log_in"), new_session_path, class: "link-ocean" %></p>
</div>
