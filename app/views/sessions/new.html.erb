<div class="container mt-4" style="max-width: 440px;">
  <%= render "shared/intro" %>

  <h2 class="h4 text-center mb-3"><%= t("sessions.new.title") %></h2>

  <div class="card p-3 shadow-sm mb-4">
    <%= form_with url: session_path, class: "d-flex flex-column gap-2" do |f| %>
      <%= f.label :email_address, t("auth.email") %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            class: "form-control", value: params[:email_address] %>

      <%= f.label :password, t("auth.password") %>
      <%= f.password_field :password, required: true, autocomplete: "current-password",
            maxlength: 72, class: "form-control" %>

      <%= f.submit t("sessions.new.submit"), class: "btn btn-ocean mt-2" %>
    <% end %>
  </div>

  <p><%= t("sessions.new.no_account") %> <%= link_to t("sessions.new.sign_up"), new_registration_path, class: "link-ocean" %></p>
  <p><%= link_to t("sessions.new.forgot_password"), new_password_path, class: "link-ocean" %></p>
</div>
